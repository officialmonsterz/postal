<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; background-color: #f7f8fa; margin: 0; padding: 20px; }
    .container { max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
    .header { background-color: #f8f9fa; padding: 20px 24px; border-bottom: 1px solid #e9ecef; }
    .header h1 { margin: 0; font-size: 18px; color: #1a1a2e; }
    .body { padding: 24px; color: #333333; line-height: 1.6; }
    .button { display: inline-block; padding: 12px 28px; background-color: #1a1a2e; color: #ffffff !important; text-decoration: none; border-radius: 4px; font-size: 14px; }
    .footer { padding: 16px 24px; color: #999999; font-size: 12px; text-align: center; border-top: 1px solid #e9ecef; }
    a { color: #1a73e8; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= subject || campaign_name || 'Notification' %></h1>
    </div>
    <div class="body">
      <p>Hello <%= recipient_name %>,</p>
      <%= body_html || '<p>This is an important notification regarding your account.</p>' %>
      <% if action_link || action_url %>
      <p style="text-align: center; margin: 24px 0;">
        <a class="button" href="<%= action_link || action_url %>"><%= action_text || 'View Details' %></a>
      </p>
      <% end %>
      <p>Thank you,<br><%= sender_name || 'Team' %></p>
    </div>
    <div class="footer">
      <p><%= company_name || 'Your Company' %> &mdash; All rights reserved &copy; <%= Time.now.year %></p>
      <% if unsubscribe_link %>
      <p><a href="<%= unsubscribe_link %>">Unsubscribe</a></p>
      <% end %>
    </div>
  </div>
</body>
</html>
